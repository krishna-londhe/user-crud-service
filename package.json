{
  "name": "user-crud-service",
  "version": "1.0.0",
  "description": "User CRUD API - Express + TypeScript + Sequelize (MySQL), following the reancare-service layered pattern",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "mocha"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.0",
    "express-validator": "^6.15.0",
    "mysql2": "^3.9.7",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.30.0",
    "sequelize-typescript": "^2.1.6",
    "tsyringe": "^4.8.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^4.3.16",
    "@types/express": "^4.17.17",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.17.15",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
