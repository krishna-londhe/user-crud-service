meta {
  name: 04 - Get user by id - not found - should fail
  type: http
  seq: 4
}

get {
  url: {{BASE_URL}}/users/00000000-0000-4000-8000-000000000000
  body: none
  auth: none
}

tests {
  test("Request fails with not-found", function () {
      expect(res.getStatus()).to.equal(404);
      var jsonRes = res.getBody();
      expect(jsonRes.Status).to.eql('failure');
  });
}

docs {
  A well-formed but non-existent uuid should return 404.
}
