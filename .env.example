NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=user_crud_db
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DIALECT=mysql
DB_POOL_MIN=2
