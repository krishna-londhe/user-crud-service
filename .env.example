NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=user_crud_db
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DIALECT=mysql
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
# When true, Sequelize will ALTER tables to match models on every boot (dev only).
DB_SYNCHRONIZE=true

# Client (app-level) authentication - every request must send this value in the
# x-api-key header, except /api/v1/health.
CLIENT_API_KEY=changeme-client-api-key

# User (login) authentication - JWT access token returned by POST /api/v1/auth/login.
USER_ACCESS_TOKEN_SECRET=changeme-access-token-secret
ACCESS_TOKEN_EXPIRES_IN_SECONDS=3600
